# ===== chat_api configuration =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
WS_PATH=/ws

# Database (postgres)
DATABASE_URL=postgres://user:password@localhost:5432/chat_api?sslmode=disable
# Security
JWT_SECRET=change-me-in-production
JWT_TTL_MINUTES=60

# TLS (optional) — set to enable wss://
TLS_CERT_FILE=
TLS_KEY_FILE=